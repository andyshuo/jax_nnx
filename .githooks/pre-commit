#!/usr/bin/env bash
# Local CI gate: lint, the full test suite and the entrypoint smoke test run on
# every commit. This repository deliberately has no GitHub Actions workflow.
#
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v pixi >/dev/null 2>&1; then
  echo "pre-commit: pixi not found, skipping the local gate" >&2
  exit 0
fi

echo "pre-commit: running 'pixi run ci' (lint + tests + entrypoint smoke)..." >&2
pixi run ci
